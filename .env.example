# NEXUS AI local environment. Copy to `.env` (`make env`) and adjust.
# `.env` is git-ignored. Never commit real credentials.
#
# This single file is read by:
#   * Docker Compose (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / POSTGRES_PORT)
#   * the backend via `uv run --env-file ../../.env` (see Makefile)
# The frontend has its own optional file: apps/web/.env.example

# --- Application -------------------------------------------------------------
# local | test | production
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# console | json (json required in production)
LOG_FORMAT=console
API_HOST=127.0.0.1
API_PORT=8000
# comma-separated, no wildcard
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL (Docker, published on 127.0.0.1 only) ---------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nexus

# --- Database tuning (optional) ----------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_HEALTH_TIMEOUT_SECONDS=2
