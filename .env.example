# NEXUS AI local environment. Copy to `.env` (`make env`) and adjust.
# `.env` is git-ignored. Never commit real credentials.
#
# This single file is read by:
#   * Docker Compose (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / POSTGRES_PORT)
#   * the backend via `uv run --env-file ../../.env` (see Makefile)
# The frontend has its own optional file: apps/web/.env.example

# --- Application -------------------------------------------------------------
# local | test | production
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# console | json (json required in production)
LOG_FORMAT=console
API_HOST=127.0.0.1
API_PORT=8000
# comma-separated, no wildcard
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL (Docker, published on 127.0.0.1 only) ---------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nexus

# --- Database tuning (optional) ----------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_HEALTH_TIMEOUT_SECONDS=2

# --- Uploads (optional) ----------------------------------------------------------
# Maximum PDF size in bytes (20 MiB) and page count.
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=500
# Extracted-text caps (protect against small PDFs that expand to huge text).
MAX_PAGE_CHARS=100000
MAX_DOCUMENT_CHARS=5000000

# --- Embeddings (optional) -------------------------------------------------------
# Pinned model and revision (a commit hash, never a branch). `make models` downloads it.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# Empty = Hugging Face default cache (~/.cache/huggingface/hub, or $HF_HOME/hub).
# EMBEDDING_CACHE_DIR=
EMBEDDING_BATCH_SIZE=16
EMBEDDING_THREADS=4

# --- Chunking and ingestion (optional) -------------------------------------------
# Tokens of the embedding model's tokenizer; CHUNK_TOKENS <= 496.
CHUNK_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
INGEST_MAX_CONCURRENCY=1
INGEST_QUEUE_CAPACITY=8

# --- Search (optional) -----------------------------------------------------------
SEARCH_TOP_K_MAX=20
SEARCH_EF_SEARCH=64
