# NEXUS AI web: copy to `.env.local` (git-ignored) only if you need to override defaults.
# Both variables are SERVER-ONLY (no NEXT_PUBLIC_ prefix) and are read at request time.

# Base URL of the NEXUS API as reached from the Next.js server.
API_BASE_URL=http://127.0.0.1:8000
# Upper bound for each backend request, in milliseconds (100-30000).
API_TIMEOUT_MS=3000
